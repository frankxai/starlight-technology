NEXT_PUBLIC_POLAR_TECH_STUDIO_URL=
NEXT_PUBLIC_POLAR_TECH_OPS_URL=
NEXT_PUBLIC_POLAR_BLUEPRINT_URL=
NEXT_PUBLIC_POLAR_STACK_AUDIT_URL=
NEXT_PUBLIC_POLAR_INFRASTRUCTURE_BLUEPRINT_URL=

# Hardware affiliate URLs. Set only partner-issued URLs. Each URL also requires
# an approved, unexpired record in data/commerce/approved-offers.json.
STARLIGHT_AFFILIATE_DGX_SPARK_URL=
STARLIGHT_AFFILIATE_RTX_5090_URL=
STARLIGHT_AFFILIATE_MINISFORUM_URL=
STARLIGHT_AFFILIATE_MAC_STUDIO_URL=
STARLIGHT_AFFILIATE_UGREEN_NAS_URL=
STARLIGHT_AFFILIATE_SAMSUNG_SSD_URL=
STARLIGHT_AFFILIATE_STREAM_DECK_URL=
STARLIGHT_AFFILIATE_RODE_URL=

# Shop (all optional; absent values keep every paid path closed)
# https endpoint that receives availability requests (for example an n8n webhook). Without it the form offers the email fallback.
SHOP_AVAILABILITY_ENDPOINT=
SHOP_AVAILABILITY_TOKEN=
# Payment provider webhook secret. Without it /api/shop/webhooks/payment rejects every delivery.
SHOP_PAYMENT_WEBHOOK_SECRET=
# Verified https checkout URL per SKU. Only honoured when every fulfilment gate is satisfied and the product is live.
SHOP_CHECKOUT_URL_ST_WE_S2B_001=
# Set to the measurement contract version (v1) to enable shop analytics events. Off by default.
NEXT_PUBLIC_SHOP_ANALYTICS=
